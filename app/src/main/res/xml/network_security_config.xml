<?xml version="1.0" encoding="utf-8"?>
<!-- System CAs only (no user-installed CAs => no MITM on HTTPS subscription fetches). Cleartext is allowed because
     some panels only serve subscriptions over http:// (the user's own choice of link); everything else is HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Local Xray inbound used for health checks -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
